<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap android:src="@drawable/app_wallpaper" android:gravity="fill" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#56000000" />
        </shape>
    </item>
    <item android:gravity="top|center_horizontal" android:width="360dp" android:height="360dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="250dp"
                android:centerX="50%" android:centerY="30%"
                android:startColor="#55FF002A" android:centerColor="#22900020"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>