<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap android:src="@drawable/app_wallpaper" android:gravity="fill" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#65030007" />
        </shape>
    </item>
    <item android:gravity="top|center_horizontal" android:width="380dp" android:height="380dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="260dp"
                android:centerX="50%" android:centerY="28%"
                android:startColor="#66FF1028" android:centerColor="#22900010"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>