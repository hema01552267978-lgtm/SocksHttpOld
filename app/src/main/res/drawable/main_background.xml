<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#20070D"
                android:centerColor="#0B0D13"
                android:endColor="#030407" />
        </shape>
    </item>
    <item android:gravity="top|center_horizontal" android:width="360dp" android:height="360dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="250dp"
                android:centerX="50%"
                android:centerY="30%"
                android:startColor="#55B00025"
                android:centerColor="#22900020"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item android:gravity="bottom|center_horizontal" android:width="300dp" android:height="240dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="210dp"
                android:centerX="50%"
                android:centerY="70%"
                android:startColor="#338A001B"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
