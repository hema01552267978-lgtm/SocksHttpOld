<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#FF5A626F" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF8F1930" />
            <stroke android:width="1dp" android:color="#FFFF879A" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FFE12B4B" android:endColor="#FFB51635" />
            <stroke android:width="1dp" android:color="#FFFF7188" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
