<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF7E1830" />
            <stroke android:width="1.5dp" android:color="#FFFF7183" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#FF252832" />
            <stroke android:width="1dp" android:color="#FF555D69" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E810121A" />
            <stroke android:width="1.2dp" android:color="#FFFF526F" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
