<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#99FFFFFF">
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="130dp"
                android:centerX="50%" android:centerY="42%"
                android:startColor="#FFFF3548" android:centerColor="#FF9C1024"
                android:endColor="#FF21050A" />
