<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/activity_mainLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="7dp"
        android:paddingBottom="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- Brand over the skull / Palestine wallpaper -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="8dp">
            <TextView
                android:id="@+id/activity_mainAutorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✹⃝𝑰🇵🇸⃝𝑬𝑳M𝑨𝑳oo3n✯"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:textSize="25sp"
                android:gravity="center"
                android:shadowColor="#FFFF1028"
                android:shadowRadius="12"
                android:shadowDx="0"
                android:shadowDy="0"
                android:singleLine="true"
                android:ellipsize="fit"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥  ELMALOO3N VPN  🔥"
                android:textColor="#FFFFE8EA"
                android:textStyle="bold"
                android:textSize="13sp"
                android:gravity="center"
                android:shadowColor="#FFFF001A"
                android:shadowRadius="7"/>
        </LinearLayout>

        <!-- Main connection control with live side counters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="5dp"
                android:background="@drawable/panel_glass">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱"
                    android:textColor="#FFFF7A18"
                    android:textSize="25sp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="السرعة الحالية"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:gravity="center"/>
                <TextView
                    android:id="@+id/vpn_network_speed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="جارٍ القياس..."
                    android:textColor="#FF39F52E"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:maxLines="3"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.45"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="3dp">
                <Button
                    android:id="@+id/activity_starterButtonMain"
                    android:layout_width="148dp"
                    android:layout_height="148dp"
                    android:background="@drawable/button_connect"
                    android:backgroundTint="@null"
                    android:text="⏻\nاتصال"
                    android:textColor="#FFFFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:elevation="10dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="5dp"
                android:background="@drawable/panel_glass">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◷"
                    android:textColor="#FFFF9BA8"
                    android:textSize="27sp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="مدة الاتصال"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:gravity="center"/>
                <TextView
                    android:id="@+id/vpn_elapsed_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="غير متصل"
                    android:textColor="#FFFFE34A"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:maxLines="2"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Config expiry countdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/panel_glass">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌛"
                android:textColor="#FFB000FF"
                android:textSize="27sp"
                android:paddingEnd="10dp"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="انتهاء الكونفج"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/config_expiry_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="جارٍ فحص الصلاحية..."
                    android:textColor="#FFFF526F"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:maxLines="2"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↻"
                android:textColor="#FFFFFFFF"
                android:textSize="25sp"
                android:paddingStart="8dp"/>
        </LinearLayout>

        <!-- Config picker -->
        <LinearLayout
            android:id="@+id/activity_mainInputProxyLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="9dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/panel_glass"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="5dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▦"
                    android:textColor="#FFFFFFFF"
                    android:textSize="21sp"
                    android:paddingEnd="10dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="اختر الكونفج"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📁 إدارة"
                    android:textColor="#FFFFAAB5"
                    android:textStyle="bold"
                    android:textSize="13sp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/activity_mainProxyText"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/no_value"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="middle"
                android:background="@drawable/button_outline"/>
        </LinearLayout>

        <!-- SSH credentials, shown by the existing configuration logic when needed -->
        <LinearLayout
            android:id="@+id/activity_mainInputPasswordLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="9dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/panel_glass">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="بيانات تسجيل الدخول"
                android:textColor="#FFFF7183"
                android:textStyle="bold"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginBottom="5dp"/>
            <android.support.design.widget.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <android.support.design.widget.TextInputEditText
                    android:id="@+id/activity_mainInputPasswordUserEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#FFD8C9CE"
                    android:hint="@string/auth_username"/>
            </android.support.design.widget.TextInputLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp">
                <android.support.design.widget.TextInputLayout
                    android:id="@+id/fragment_userpassTextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <android.support.design.widget.TextInputEditText
                        android:id="@+id/activity_mainInputPasswordPassEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:inputType="textPassword"
                        android:textColor="#FFFFFFFF"
                        android:textColorHint="#FFD8C9CE"
                        android:hint="@string/password"/>
                </android.support.design.widget.TextInputLayout>
                <ImageButton
                    android:id="@+id/activity_mainInputShowPassImageButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_visibility_off_black_24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/show_password"/>
            </RelativeLayout>
        </LinearLayout>

        <!-- Connection method and custom payload -->
        <LinearLayout
            android:id="@+id/activity_mainMetodoConexaoLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="9dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/panel_glass">
            <TextView
                android:id="@+id/activity_mainMetodoConexaoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡  إعدادات الاتصال"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingStart="4dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <RadioGroup
                    android:id="@+id/activity_mainMetodoConexaoRadio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <android.support.v7.widget.AppCompatRadioButton
                        android:id="@+id/activity_mainSSHDirectRadioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SSH Direct"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:padding="3dp"/>
                    <android.support.v7.widget.AppCompatRadioButton
                        android:id="@+id/activity_mainSSHProxyRadioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SSH Proxy"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:padding="3dp"/>
                </RadioGroup>
                <android.support.v7.widget.SwitchCompat
                    android:id="@+id/activity_mainCustomPayloadSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payload مخصص"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/activity_mainInputPayloadLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/panel_glass">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Payload :"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:gravity="end"/>
            <android.support.design.widget.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <android.support.design.widget.TextInputEditText
                    android:id="@+id/activity_mainInputPayloadEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textLongMessage"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#FFD8C9CE"
                    android:hint="اكتب البايلود هنا..."
                    android:background="@drawable/button_outline"/>
            </android.support.design.widget.TextInputLayout>
        </LinearLayout>

        <!-- Existing working import / save / export actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="2dp">
            <Button
                android:id="@+id/btn_import_config"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:minWidth="0dp"
                android:text="📂 استيراد"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/button_red"
                android:backgroundTint="@null"/>
            <Button
                android:id="@+id/btn_save_config"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:minWidth="0dp"
                android:text="💾 حفظ"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/button_red"
                android:backgroundTint="@null"/>
            <Button
                android:id="@+id/btn_export_config"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:minWidth="0dp"
                android:text="📤 تصدير"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/button_red"
                android:backgroundTint="@null"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_wa_dev"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:text="✉  تواصل مع المطوّر"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/button_outline"
            android:backgroundTint="@null"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/activity_connection_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✓ جاهز للاتصال"
                android:textColor="#FF39F52E"
                android:textStyle="bold"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ELMALOO3N  •  VPN"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:textSize="11sp"/>
            <LinearLayout
                android:id="@+id/activity_mainMensagemConfigLinearLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:orientation="vertical"
                android:padding="0dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/activity_mainMensagemConfigTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:autoLink="web"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>